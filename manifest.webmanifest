{
  "id": "./",
  "name": "رواق",
  "short_name": "رواق",
  "description": "على مهلك. A calm, private, offline life app.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121428",
  "theme_color": "#121428",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "فرّغ راسك", "short_name": "فرّغ راسك", "description": "Empty your head", "url": "./?do=capture", "icons": [{ "src": "icons/shortcut-capture.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "ابدأ ١٠ دقايق", "short_name": "ابدأ ١٠ دقايق", "description": "Just start for 10 minutes", "url": "./?do=focus", "icons": [{ "src": "icons/shortcut-focus.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "تنفّس", "short_name": "تنفّس", "description": "Breathe", "url": "./?do=breathe", "icons": [{ "src": "icons/shortcut-breathe.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  }
}
